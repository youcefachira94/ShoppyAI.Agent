<Window x:Class="ShoppyAI.Desktop.LanguageCorrectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language corrections"
        Width="720"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#111827">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <EventSetter Event="TextChanged" Handler="Field_TextChanged"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Language corrections"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Foreground="#94A3B8"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"
                       Text="Meanings you confirm here are given to ShoppyAI with the highest priority (for example: doka = maintenant). They stay on this PC. Select a line to edit it, untick to disable without deleting; every change can be undone."/>
        </StackPanel>

        <ListBox x:Name="CorrectionsList"
                 Grid.Row="1"
                 Background="#0B1220"
                 BorderBrush="#374151"
                 Foreground="White"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="CorrectionsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,4">
                        <CheckBox DockPanel.Dock="Left"
                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Click="Enabled_Click"
                                  VerticalAlignment="Center"
                                  ToolTip="Use this correction"
                                  Margin="0,0,10,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="14">
                            <Run Text="{Binding Term, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" = " Foreground="#94A3B8"/>
                            <Run Text="{Binding Meaning, Mode=OneWay}"/>
                            <Run Text="{Binding Note, Mode=OneWay, StringFormat='  — {0}'}" Foreground="#94A3B8"/>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="WORD OR EXPRESSION" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TermBox" Style="{StaticResource Field}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="MEANING" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MeaningBox" Style="{StaticResource Field}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource Field}"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
            <Button Content="Save"
                    Click="Save_Click"
                    Style="{StaticResource ActionButton}"
                    Background="#2563EB"
                    Foreground="White"/>
            <Button Content="New" Click="New_Click" Style="{StaticResource ActionButton}" ToolTip="Clear the fields to add another word"/>
            <Button Content="Delete" Click="Delete_Click" Style="{StaticResource ActionButton}"/>
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Style="{StaticResource ActionButton}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="0"/>
            <TextBlock x:Name="StatusText"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
