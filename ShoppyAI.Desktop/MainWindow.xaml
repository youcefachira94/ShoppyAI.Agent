<Window x:Class="ShoppyAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShoppyAI"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0B1220" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ShoppyAI"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,25"/>

                    <Button Content="+ New Chat"
                            Click="NewChat_Click"
                            Height="42"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="WORKSPACE"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <Button Content="Project Files"
                            Click="ProjectFiles_Click"
                            Height="38"
                            Background="Transparent"
                            Foreground="#D1D5DB"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="Git Status"
                            Click="GitStatus_Click"
                            Height="38"
                            Background="Transparent"
                            Foreground="#D1D5DB"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>

                    <TextBlock Text="REPLY LANGUAGE"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,20,0,8"/>

                    <!-- Saved preferences. Auto follows the conversation; just asking in the chat also works. -->
                    <WrapPanel x:Name="ReplyLanguagePanel">
                        <WrapPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Setter Property="Margin" Value="0,3,14,3"/>
                                <Setter Property="GroupName" Value="ReplyLanguage"/>
                                <EventSetter Event="Click" Handler="ReplyLanguage_Click"/>
                            </Style>
                        </WrapPanel.Resources>
                        <RadioButton Content="Auto" Tag="Auto"/>
                        <RadioButton Content="Darija" Tag="Darija"/>
                        <RadioButton Content="Français" Tag="French"/>
                        <RadioButton Content="English" Tag="English"/>
                        <RadioButton Content="العربية الفصحى" Tag="StandardArabic"/>
                    </WrapPanel>

                    <TextBlock Text="DARIJA ALPHABET"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,12,0,6"/>

                    <WrapPanel x:Name="ReplyScriptPanel">
                        <WrapPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Setter Property="Margin" Value="0,3,14,3"/>
                                <Setter Property="GroupName" Value="ReplyScript"/>
                                <EventSetter Event="Click" Handler="ReplyScript_Click"/>
                            </Style>
                        </WrapPanel.Resources>
                        <RadioButton Content="Auto" Tag="Auto"/>
                        <RadioButton Content="العربية" Tag="Arabic"/>
                        <RadioButton Content="Latin" Tag="Latin"/>
                    </WrapPanel>

                    <CheckBox x:Name="RememberPreferencesBox"
                              Content="Remember for new chats"
                              Foreground="#D1D5DB"
                              Margin="0,10,0,0"
                              Click="RememberPreferences_Click"/>

                    <TextBlock x:Name="ConversationPreferenceText"
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>

                    <Button Content="Reset preferences"
                            Click="ResetPreferences_Click"
                            Height="30"
                            Margin="0,6,0,0"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="Language corrections"
                            Click="LanguageCorrections_Click"
                            Height="38"
                            Margin="0,8,0,0"
                            Background="Transparent"
                            Foreground="#D1D5DB"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Local Coding Agent"
                           Foreground="#64748B"
                           FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="New conversation"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <ScrollViewer x:Name="MessagesScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Shown only while waiting for the first words of an answer; never part of the conversation. -->
            <TextBlock x:Name="TypingIndicator"
                       Grid.Row="2"
                       Text="ShoppyAI is writing…"
                       Foreground="#94A3B8"
                       FontStyle="Italic"
                       FontSize="13"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageBox"
                         MinHeight="52"
                         MaxHeight="160"
                         Padding="15"
                         FontSize="15"
                         Background="#1F2937"
                         Foreground="White"
                         BorderBrush="#374151"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="MessageBox_TextChanged"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Click="Send_Click"
                        VerticalAlignment="Bottom"
                        Height="52"
                        Margin="12,0,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>