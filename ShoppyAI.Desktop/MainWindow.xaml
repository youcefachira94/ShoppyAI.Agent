<Window x:Class="ShoppyAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShoppyAI"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0B1220" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ShoppyAI"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,25"/>

                    <Button Content="+ New Chat"
                            Click="NewChat_Click"
                            Height="42"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="WORKSPACE"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <Button Content="Project Files"
                            Click="ProjectFiles_Click"
                            Height="38"
                            Background="Transparent"
                            Foreground="#D1D5DB"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="Git Status"
                            Click="GitStatus_Click"
                            Height="38"
                            Background="Transparent"
                            Foreground="#D1D5DB"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Local Coding Agent"
                           Foreground="#64748B"
                           FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="New conversation"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageBox"
                         Height="52"
                         Padding="15"
                         FontSize="15"
                         Background="#1F2937"
                         Foreground="White"
                         BorderBrush="#374151"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <Button Grid.Column="1"
                        Content="Send"
                        Click="Send_Click"
                        Height="52"
                        Margin="12,0,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>