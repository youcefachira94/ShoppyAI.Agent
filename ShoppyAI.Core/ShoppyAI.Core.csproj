<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShoppyAI.Tests" />
  </ItemGroup>

  <!-- Language data lives in plain files so it can be extended without touching code. -->
  <ItemGroup>
    <EmbeddedResource Include="Language\Data\*" LogicalName="ShoppyAI.Language.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
